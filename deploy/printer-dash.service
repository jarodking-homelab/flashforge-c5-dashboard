[Unit]
Description=Flashforge Creator 5 Pro dashboard (printer-dash)
After=network-online.target
Wants=network-online.target

[Service]
User=printerdash
Group=printerdash
ExecStart=/usr/bin/python3 /opt/printer-dash/server.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/printer-dash
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
